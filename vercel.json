{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web-app/frontend && npm run build",
  "outputDirectory": "web-app/frontend/.next",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/docs",
      "has": [
        { "type": "query", "key": "doc", "value": "readme" }
      ],
      "destination": "/docs/readme?",
      "statusCode": 308
    },
    {
      "source": "/docs/",
      "has": [
        { "type": "query", "key": "doc", "value": "readme" }
      ],
      "destination": "/docs/readme?",
      "statusCode": 308
    },
    {
      "source": "/docs/readme",
      "has": [
        { "type": "query", "key": "doc", "value": "readme" }
      ],
      "destination": "/docs/readme?",
      "statusCode": 308
    },
    {
      "source": "/docs",
      "has": [
        { "type": "query", "key": "doc", "value": "implementation" }
      ],
      "destination": "/docs/implementation-info?",
      "statusCode": 308
    },
    {
      "source": "/docs/",
      "has": [
        { "type": "query", "key": "doc", "value": "implementation" }
      ],
      "destination": "/docs/implementation-info?",
      "statusCode": 308
    },
    {
      "source": "/docs/implementation-info",
      "has": [
        { "type": "query", "key": "doc", "value": "implementation" }
      ],
      "destination": "/docs/implementation-info?",
      "statusCode": 308
    }
  ]
}
